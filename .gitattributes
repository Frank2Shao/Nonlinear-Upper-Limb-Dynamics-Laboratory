# Keep LF on every platform, regardless of a machine's core.autocrlf.
# Hashed static assets (static/vendor/manifest.json) depend on exact bytes.
* text=auto eol=lf

# Binary assets: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
