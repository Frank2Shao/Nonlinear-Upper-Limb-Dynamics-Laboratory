POSTGRES_DB=nuldl
POSTGRES_USER=nuldl
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_TEST_DB=nuldl_test

# Entry points select their own safe defaults. Uncomment only for an explicit override.
# DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=django-insecure-local-development-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=postgresql://nuldl:local-development-only@127.0.0.1:5432/nuldl

EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=local-placeholder
EMAIL_HOST_PASSWORD=local-placeholder
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.invalid
