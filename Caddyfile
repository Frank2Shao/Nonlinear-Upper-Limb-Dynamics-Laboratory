{
	# Logs never carry the request (URL, headers or client IP); no access log is kept.
	log {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	handle /static/* {
		root * /srv
		header X-Content-Type-Options nosniff
		@hashed path_regexp \.[0-9a-f]{12}\.[a-z0-9]+$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Avatars are public under random file names (design_document.md 11.2).
	handle /media/* {
		root * /srv
		header X-Content-Type-Options nosniff
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
