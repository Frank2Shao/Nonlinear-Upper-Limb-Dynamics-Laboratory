# Copy to .env.production on the server (chmod 600) and fill it in there.
# Never commit the real file or paste its values into a chat.

# The domain only, without https://
SITE_DOMAIN=example.invalid

# Long random value: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Letters and digits only (it is placed inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# The club Gmail account and its app password (not the login password), no spaces.
GMAIL_ADDRESS=club@example.invalid
GMAIL_APP_PASSWORD=

# Comma-separated addresses that receive server error emails.
DJANGO_ADMINS=admin@example.invalid
